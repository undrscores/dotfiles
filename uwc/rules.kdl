// Translucent terminal so the blur shows through
rule {
    match app-id="foot"
    opacity 0.75
    blur-radius 14
}
rule {
    match app-id="mpv"
    open { pinned; size 640 360; position 20 20; focus false }
    corner-radius 0
    shadow-size 0
}

// Content windows stay opaque and undimmed: no tint on video or pages when they lose focus.
rule {
    match app-id="firefox"
    match app-id="vlc"
    match fullscreen=true
    opacity 1
    inactive-opacity 1
    inactive-dim 0
}
// Fullscreen fills the screen: no rounded corners or shadow.
rule {
    match fullscreen=true
    corner-radius 0
    shadow-size 0
}
