// Colours are ANSI names, so they follow the wallpaper-generated terminal palette.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "small", "padding": { "top": 1, "right": 3 }, "color": { "1": "blue", "2": "magenta" } },
  "display": { "separator": "  ", "key": { "width": 9 }, "color": { "keys": "blue", "title": "magenta" } },
  "modules": [
    { "type": "title", "format": "{user-name-colored}@{host-name-colored}" },
    { "type": "os",       "key": "os",    "format": "{name}" },
    { "type": "kernel",   "key": "kern",  "format": "{release}" },
    { "type": "wm",       "key": "wm" },
    { "type": "shell",    "key": "sh" },
    { "type": "terminal", "key": "term" },
    { "type": "font",     "key": "font" },
    { "type": "memory",   "key": "mem",   "format": "{used} / {total}" },
    { "type": "uptime",   "key": "up" },
    { "type": "colors",   "symbol": "circle", "paddingLeft": 12 }
  ]
}
